# Mosque Digital Clock - Environment Variables Template
# Copy this to .env and fill in your values

# ============================================
# DATABASE CONFIGURATION
# ============================================

# Option 1: Using DATABASE_URL (recommended)
DATABASE_URL=mysql://user:password@localhost:3306/mosque-digitaldb

# Option 2: Individual database settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=mosque_user
DB_PASSWORD=your_secure_password_here
DB_NAME=mosque-digitaldb
DB_POOL_LIMIT=10

# ============================================
# SESSION SECURITY
# ============================================

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_secret_key_min_32_chars

# ============================================
# GOOGLE OAUTH CONFIGURATION
# ============================================

# Get from: https://console.cloud.google.com/
# 1. Create project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Set Authorized redirect URI:
#    - Development: http://localhost:3011/api/auth/google/callback
#    - Production: https://yourdomain.com/api/auth/google/callback

GOOGLE_CLIENT_ID=your_client_id_from_google_console.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_from_google_console

# Application base URL
NEXTAUTH_URL=http://localhost:3011

# ============================================
# NODE ENVIRONMENT
# ============================================

NODE_ENV=development
# Options: development, production, test

# ============================================
# API CONFIGURATION
# ============================================

# Base URL for API calls (from client perspective)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# API base URL (from server perspective)
API_BASE_URL=http://localhost:3001

# ============================================
# EMAIL SERVICE (Optional)
# ============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM=noreply@yourdomain.com

# ============================================
# REDIS CONFIGURATION (Optional - for rate limiting)
# ============================================

REDIS_URL=redis://localhost:6379

# ============================================
# MONITORING & LOGGING
# ============================================

# Sentry for error tracking (optional)
SENTRY_DSN=https://your_sentry_key@sentry.io/project_id

# Log level
LOG_LEVEL=info
# Options: debug, info, warn, error

# ============================================
# WA-BOT CONFIGURATION (Optional)
# ============================================

WABOT_ENABLED=false
WABOT_API_URL=http://localhost:8000
WABOT_AUTH_TOKEN=your_wabot_token

# ============================================
# PUSH NOTIFICATIONS (Optional)
# ============================================

# VAPID keys for Web Push notifications
# Generate with: npm install -g web-push
# Then: web-push generate-vapid-keys

VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# ============================================
# SMART MQTT DEVICES (Optional)
# ============================================

MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USER=mqtt_user
MQTT_PASSWORD=mqtt_password

# ============================================
# ADMIN CREDENTIALS (Development Only)
# ============================================

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_password_dev_only

# ============================================
# FEATURE FLAGS
# ============================================

ENABLE_GOOGLE_OAUTH=true
ENABLE_WABOT=false
ENABLE_LIVE_STREAMING=true
ENABLE_ANALYTICS=true
ENABLE_SMART_DEVICES=false

# ============================================
# TIMEOUTS & LIMITS
# ============================================

# API request timeout (milliseconds)
API_TIMEOUT=30000

# Config fetch retry attempts
CONFIG_FETCH_RETRIES=3

# Rate limiting (requests per minute)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=60
RATE_LIMIT_UPLOAD=10

# ============================================
# FILE UPLOAD
# ============================================

MAX_UPLOAD_SIZE_MB=50
UPLOAD_PATH=/uploads
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp,gif
ALLOWED_AUDIO_TYPES=mp3,wav,ogg,m4a

# ============================================
# TIMEZONE & LOCATION
# ============================================

# Timezone for server (affects prayer time calculations)
TZ=Asia/Jakarta

# ============================================
# DOCKER CONFIGURATION
# ============================================

# Port mappings (if using Docker)
WEB_ADMIN_PORT=3011
WEB_CLIENT_PORT=3012
API_PORT=3001

# ============================================
# BACKUP & RETENTION
# ============================================

# Days to keep activity logs
LOG_RETENTION_DAYS=90

# Days to keep backup files
BACKUP_RETENTION_DAYS=30

# ============================================
# DEVELOPMENT ONLY
# ============================================

# Allow HTTP in development (not for production)
ALLOW_HTTP=true

# Debug mode
DEBUG=true

# Suppress external service calls
MOCK_EXTERNAL_SERVICES=false

# Sample prayer times for testing
TEST_PRAYER_TIMES=false
