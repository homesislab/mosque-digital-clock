# ============================================
# Database Configuration
# ============================================
# Option 1: Use DATABASE_URL (recommended for production)
# DATABASE_URL=mysql://username:password@host:port/database

# Option 2: Use individual environment variables (for development)
DB_HOST=localhost
DB_PORT=3306
DB_USER=mosque_user
DB_PASSWORD=your_secure_password_here
DB_NAME=mosque-digitaldb

# ============================================
# Google OAuth Configuration
# ============================================
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
NEXTAUTH_URL=https://yourdomain.com

# ============================================
# Session & Security
# ============================================
SESSION_SECRET=your_random_32_char_secret_here
NODE_ENV=production

# ============================================
# Application Configuration
# ============================================
NEXT_PUBLIC_API_BASE_URL=https://yourdomain.com/api
IMAGE_TAG=latest

# ============================================
# Push Notifications (Web Push API)
# ============================================
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# ============================================
# MQTT Configuration (WhatsApp Bot)
# ============================================
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USER=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password

# ============================================
# Email Configuration (Optional)
# ============================================
# For password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@mosque-digital.com

# ============================================
# Redis Configuration (For caching & rate limiting)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================
# Application Features
# ============================================
# Enable/disable features
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_RATE_LIMITING=true
ENABLE_ANALYTICS=true

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=30

# ============================================
# Monitoring & Logging
# ============================================
LOG_LEVEL=info
# Optional: Sentry for error tracking
SENTRY_DSN=

# ============================================
# Docker Build
# ============================================
IMAGE_TAG=v-20260217-132303
